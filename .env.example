# --- Banco de dados ---
# Desenvolvimento (SQLite, caminho relativo a prisma/):
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL) - ver ARCHITECTURE.md para trocar o provider:
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/drogacare?schema=public"

# --- Segredos (gere com: openssl rand -base64 48) ---
SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres"
RESET_TOKEN_SECRET="troque-por-outro-segredo-diferente-do-de-sessao-32+-caracteres"

# --- URL pública do site (usada nos links de e-mail e no SEO) ---
APP_URL="http://localhost:3000"

# --- E-mail (recuperação de senha) ---
# Se SMTP_URL estiver vazio, o e-mail é SIMULADO: o link aparece no console do servidor.
# Exemplo: smtps://usuario:senha@smtp.exemplo.com:465
SMTP_URL=""
MAIL_FROM="Drogacare <nao-responda@drogacare.com.br>"

# --- Seed do administrador inicial ---
SEED_ADMIN_EMAIL="admin@drogacare.com.br"
